# Everything here is optional. Our own knowledge base always answers first;
# an LLM is used only when the knowledge base has no confident answer.
# If several keys are set, the first one in this order is used.

# 1) Gemini (free key): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2) Groq (free key): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# 3) Grok (xAI): https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-3-mini

# 4) Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

PORT=3001
