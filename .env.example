# Everything here is optional. Our own knowledge base always answers first;
# an LLM is used only when the knowledge base has no confident answer.

# Option 1: Grok (xAI). Key from https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-3-mini

# Option 2: Claude (used only if XAI_API_KEY is empty)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

PORT=3001
